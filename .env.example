# Copy to .env if you like. Everything has a default, so none of this is required locally.
# Windows PowerShell: set each one with $env:NAME="value" before running Maven.
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
ADMIN_PASSWORD=choose-a-strong-password
ANALYST_PASSWORD=choose-another-password

# Local database (defaults match the user created in the setup guide)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=complyza
DB_USER=complyza
DB_PASSWORD=complyza
# Neon / hosted Postgres needs SSL:
# DB_PARAMS=?sslmode=require
